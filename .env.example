# OpenRouter
OPENROUTER_API_KEY=

# Models (OpenRouter model ids)
MODEL_POSTER=x-ai/grok-4.7
MODEL_IMAGE=black-forest-labs/flux-3-image-klein
MODEL_MODERATOR=deepseek/deepseek-v4.1-flash-1017
MODEL_RESPONDER=deepseek/deepseek-v4.1-flash-1017
MODEL_MANAGER=deepseek/deepseek-v4.1-flash-1017

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kitchen-autoposter

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_DISCUSSION_GROUP_ID=
MANAGER_CHAT_ID=
MANAGER_USER_ID=

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/kitchenbot

# Optional
LOG_LEVEL=INFO
TEMP_IMAGES_DIR=./temp_images
