# OpenRouter
OPENROUTER_API_KEY=

# Models (OpenRouter model ids)
MODEL_POSTER=x-ai/grok-4
MODEL_IMAGE=black-forest-labs/flux-1.1-pro
MODEL_MODERATOR=openai/gpt-4o-mini
MODEL_RESPONDER=openai/gpt-4o-mini
MODEL_MANAGER=openai/gpt-4o-mini

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=kitchen-autoposter

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_DISCUSSION_GROUP_ID=
MANAGER_CHAT_ID=
MANAGER_USER_ID=

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/kitchenbot

# Optional
LOG_LEVEL=INFO
TEMP_IMAGES_DIR=./temp_images
